# QML DataFlow Studio — Environment Configuration
# Copy this file to .env and edit as needed:  cp .env.example .env

# Server
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Storage (defaults to project-local directories)
UPLOAD_DIR=uploads
MODELS_DIR=models
LOGS_DIR=logs

# Upload limits
MAX_UPLOAD_MB=50

# CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*

# ── Kipu Quantum Hub ──────────────────────────────────────────────────────────
# Personal access token from https://dashboard.hub.kipu-quantum.com
# Settings → Access Tokens → copy your token here
# Leave blank to use local Qiskit Aer only
KIPU_TOKEN=

# Default Kipu backend to use when framework = "kipu"
# Options visible at: https://dashboard.hub.kipu-quantum.com/quantum-backends
#   qudora.sim.xgl   — Qamelion Emulator   (recommended)
#   kipu.sim.qsim    — Kipu QSim Simulator
#   aws.sim.sv1      — AWS Braket SV1
KIPU_BACKEND=qudora.sim.xgl
